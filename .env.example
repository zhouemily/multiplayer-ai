# Neo4j Aura connection (copy to .env and fill in).
# Newer Aura instances use the instance ID as the username — copy these
# straight from the "Connect" credentials file Aura offers at creation.
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=your-username
NEO4J_PASSWORD=your-password-here

# Ports
MCP_PORT=3333
WEB_PORT=3334

# How long a claim is held before another agent may steal it. Must outlast the
# slowest step a subagent might take, or its work gets taken mid-flight.
LEASE_MINUTES=10

# How many times a subtask may fail review before it is blocked for the manager.
MAX_ATTEMPTS=3
